{
    "manifest_version": 3,
    "name": "BetterE-class",
    "version": "1.8.0",
    "description": "同志社大学のe-classをより快適に使うための非公式Chrome拡張機能。様々な便利機能を搭載し、日常での学習体験をより便利なものにします。",
    "author": "kmch4n",
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "BetterE-class 設定"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "host_permissions": ["*://eclass.doshisha.ac.jp/*"],
    "permissions": ["declarativeNetRequest", "storage", "tabs", "downloads", "clipboardWrite"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["*://eclass.doshisha.ac.jp/*"],
            "js": ["utils/settings.js"],
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "matches": ["*://eclass.doshisha.ac.jp/webclass/course.php/*"],
            "js": [
                "utils/material-icons.js",
                "utils/icons.js",
                "utils/ui-state.js",
                "utils/expand-transition.js",
                "eclass-top-button.js",
                "course-toc-sidebar.js",
                "course-timeline-toggle.js"
            ],
            "css": ["bec-tokens.css", "course-sidebars.css"],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/course.php/*/my-reports*"
            ],
            "js": ["content.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["*://eclass.doshisha.ac.jp/webclass/messages.php/inbox*"],
            "js": ["message-tools.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["*://eclass.doshisha.ac.jp/webclass/*"],
            "js": ["message-interceptor.js"],
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "matches": ["*://eclass.doshisha.ac.jp/*"],
            "js": ["deadline-highlight.js"],
            "css": ["bec-tokens.css", "deadline-highlight.css"],
            "run_at": "document_start"
        },
        {
            "matches": ["*://eclass.doshisha.ac.jp/*"],
            "js": ["dark-mode.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["*://eclass.doshisha.ac.jp/*"],
            "js": ["footer-branding.js"],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/",
                "*://eclass.doshisha.ac.jp/webclass/?*",
                "*://eclass.doshisha.ac.jp/webclass/index.php*"
            ],
            "js": ["utils/ui-state.js"],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/",
                "*://eclass.doshisha.ac.jp/webclass/?*",
                "*://eclass.doshisha.ac.jp/webclass/index.php*"
            ],
            "js": ["schedule-customizer.js"],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/",
                "*://eclass.doshisha.ac.jp/webclass/?*",
                "*://eclass.doshisha.ac.jp/webclass/index.php*"
            ],
            "js": ["utils/icons.js", "utils/deadline-api.js", "deadline-list.js"],
            "css": ["bec-tokens.css", "side-widgets.css", "deadline-list.css"],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/",
                "*://eclass.doshisha.ac.jp/webclass/?*",
                "*://eclass.doshisha.ac.jp/webclass/index.php*"
            ],
            "js": ["utils/expand-transition.js", "collapsible-sections.js"],
            "css": ["collapsible.css"],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/",
                "*://eclass.doshisha.ac.jp/webclass/?*",
                "*://eclass.doshisha.ac.jp/webclass/index.php*"
            ],
            "js": ["utils/icons.js", "pinned-courses.js"],
            "css": ["bec-tokens.css", "side-widgets.css", "pinned-courses.css"],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/txtbk_show_chapter.php*"
            ],
            "js": [
                "utils/button-factory.js",
                "utils/icons.js",
                "textbook-panel.js",
                "vendor/mux.js/mux-mp4.min.js",
                "utils/hls-mp4.js",
                "textbook-video-download.js",
                "textbook-chapter-buttons.js"
            ],
            "css": ["bec-tokens.css", "textbook-panel.css"],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/txtbk_show_chapter.php*",
                "*://eclass.doshisha.ac.jp/webclass/txtbk_show_text.php*"
            ],
            "js": ["textbook-video-autoplay.js"],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/loadit.php?action=providePDF*"
            ],
            "js": ["textbook-loadit-extractor.js"],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": ["*://eclass.doshisha.ac.jp/webclass/loadit.php*"],
            "js": ["utils/button-factory.js", "attachment-opener.js"],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/txtbk_show_text.php*"
            ],
            "js": ["utils/button-factory.js", "attachment-opener.js"],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://eclass.doshisha.ac.jp/webclass/qstn_frame.php*",
                "*://eclass.doshisha.ac.jp/webclass/dqstn_answer.php*",
                "*://eclass.doshisha.ac.jp/webclass/dqstn_button.php*",
                "*://eclass.doshisha.ac.jp/webclass/dqstn_question.php*"
            ],
            "js": [
                "utils/button-factory.js",
                "attachment-opener.js",
                "quiz-attachment-buttons.js",
                "quiz-copy-button.js",
                "quiz-export-controller.js",
                "quiz-export-all.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        }
    ]
}
